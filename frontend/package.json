{
  "name": "ai-code-security-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:real": "playwright test --config playwright.real.config.ts",
    "test:browser:webkit": "playwright test --config playwright.webkit.config.ts",
    "qa:safari": "node scripts/run-safari-manual-qa.mjs",
    "qa:investigation:safari": "node scripts/run-safari-manual-qa.mjs --investigation",
    "test:qa:investigation:safari": "node --test scripts/investigation-safari-qa.test.mjs",
    "test:qa:safari": "node --test scripts/safari-manual-qa.test.mjs",
    "test:e2e:real": "node scripts/run-real-semgrep-e2e.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
